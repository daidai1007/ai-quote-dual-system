# Render 自动提供 PORT 和 RENDER，不要在 GitHub 中填写实际值。
# DATABASE_URL 使用 Neon Connect 页面提供的 pooled 连接串。
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
AI_QUOTE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
AI_QUOTE_PSQL_TIMEOUT_MS=45000
PGSSLMODE=require
